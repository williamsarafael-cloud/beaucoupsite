---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found" description="That page could not be found." path="/404" noindex={true}>
  <section class="container page-hero" style="min-height:50vh">
    <div class="eyebrow">404</div>
    <h1>We couldn’t find that page.</h1>
    <p class="lead">It may have moved. Try one of these instead.</p>
    <div class="hero-actions" style="margin-top:32px">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-outline" href="/services">Services</a>
      <a class="btn btn-outline" href="/contact">Contact</a>
    </div>
  </section>
</Base>
