---
import Base from '../layouts/Base.astro';
---
<Base title="Thank You" description="Your message was sent." path="/thanks" noindex={true}>
  <section class="container page-hero" style="min-height:50vh">
    <div class="eyebrow">Message sent</div>
    <h1>Thank you!</h1>
    <p class="lead">Your inquiry is on its way. We’ll be in touch soon.</p>
    <p style="margin-top:32px"><a class="btn btn-primary" href="/">Back to home</a></p>
  </section>
</Base>
